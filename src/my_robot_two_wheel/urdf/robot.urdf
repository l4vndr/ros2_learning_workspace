<robot name="two_wheeled_robot">

    <link name="base_footprint">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </link>

    <link name="base_link">
        <visual name="">
            <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0" />
            <geometry>
                <box size="0.6 0.4 0.2" />
            </geometry>
            <material name="">
                <color rgba="0.0 0.5 0.0 1.0" />
                <!-- <texture filename=""/> -->
            </material>
        </visual>
    </link>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0" />
        <texture filename="" />
    </material>

    <link name="left_wheel">
        <visual name="">
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
            <geometry>
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <material name="grey" />
        </visual>
    </link>

    <link name="right_wheel">
        <visual name="">
            <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 0.0" />
            <geometry>
                <cylinder radius="0.1" length="0.05" />
            </geometry>
            <material name="grey" />
        </visual>
    </link>

    <link name="castor">
        <visual name="">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <geometry>
                <sphere radius="0.05" />
            </geometry>
            <material name="grey" />
        </visual>
    </link>

    <joint name="base_footprint_to_base_link" type="fixed">
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0" />
        <parent link="base_footprint" />
        <child link="base_link" />
    </joint>

    <joint name="base_link_to_left_wheel" type="continuous">
        <origin xyz="-0.15 0.225 0.0" rpy="0.0 0.0 0.0" />
        <parent link="base_link" />
        <child link="left_wheel" />
        <axis xyz="0.0 1.0 0.0" />
        <!-- <limit lower="-3.14" upper="3.14" effort="50.0" velocity="100.0" /> -->
    </joint>

    <joint name="base_link_to_right_wheel" type="continuous">
        <origin xyz="-0.15 -0.225 0.0" rpy="0.0 0.0 0.0" />
        <parent link="base_link" />
        <child link="right_wheel" />
        <axis xyz="0.0 1.0 0.0" />
        <!-- <limit lower="-3.14" upper="3.14" effort="50.0" velocity="100.0" /> -->
    </joint>

    <joint name="base_link_to_castor" type="fixed">
        <origin xyz="0.2 0.0 -0.05" rpy="0.0 0.0 0.0" />
        <parent link="base_link" />
        <child link="castor" />
    </joint>
</robot>
