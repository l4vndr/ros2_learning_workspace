<launch>
      <let name="urdf_file"
            value="$(find-pkg-share differential_drive_bot)/urdf/differential_drive_bot.urdf.xacro" />
      <let name="config_path"
            value="$(find-pkg-share differential_drive_bot)/rviz/differential_drive_bot_config.rviz" />

      <node pkg="robot_state_publisher" exec="robot_state_publisher">
            <param name="robot_description" value="$(command 'xacro $(var urdf_file)')" />
      </node>

      <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"></node>


      <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_root"
            args="0 0 0 0 0 0 map root" /> -->
    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var config_path)"></node>
            
</launch>
